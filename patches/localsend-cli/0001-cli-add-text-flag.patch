+/// Writes each `--text` value into a fresh scratch directory and returns the
+/// combined send list, the texts keyed by their path, and the scratch directory
+/// (`None` when no text was given, so the common case touches no disk).
+fn materialize_texts(
+    files: Vec<PathBuf>,
+    texts: &[String],
+) -> anyhow::Result<(Vec<PathBuf>, HashMap<PathBuf, String>, Option<PathBuf>)> {
+    let mut preselected = files;
+    let mut messages = HashMap::new();
+    if texts.is_empty() {
+        return Ok((preselected, messages, None));
+    }
+
+    // Prefer XDG_RUNTIME_DIR: it is tmpfs, user-private and wiped on logout,
+    // so a run killed with SIGKILL (which skips the cleanup at the end of
+    // `run`) cannot leave message text readable on disk. /tmp is the fallback.
+    let base = std::env::var_os("XDG_RUNTIME_DIR")
+        .map(PathBuf::from)
+        .filter(|dir| dir.is_dir())
+        .unwrap_or_else(std::env::temp_dir);
+    let dir = base.join(format!("localsend-cli-{}", Uuid::new_v4()));
+    std::fs::create_dir_all(&dir)?;
+    #[cfg(unix)]
+    std::fs::set_permissions(&dir, std::os::unix::fs::PermissionsExt::from_mode(0o700))?;
+    for text in texts {
+        anyhow::ensure!(!text.trim().is_empty(), "--text was empty");
+        let path = dir.join(format!("{}.txt", Uuid::new_v4()));
+        std::fs::write(&path, text.as_bytes())?;
+        preselected.push(path.clone());
+        messages.insert(path, text.clone());
+    }
+    Ok((preselected, messages, Some(dir)))
+}
