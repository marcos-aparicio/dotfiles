#!/usr/bin/env bash
# dokploy-previews — Dokploy preview deployments for the repo in the current directory.
#
# Backs the `dokploy-previews` television channel, but is usable on its own.
#
#   dokploy-previews list [<remote>]   tab separated rows, one per preview deployment:
#                                        display <TAB> preview-url <TAB> pr-url <TAB> id
#                                        <TAB> branch <TAB> pr-number
#   dokploy-previews preview <id>      detail view for the tv preview panel
#   dokploy-previews auth              resolve the credentials and exit; run this
#                                      before tv so any gpg/pass prompt happens
#                                      in a plain terminal rather than under a TUI
#   dokploy-previews open <url>        open a url in the browser
#   dokploy-previews copy <text>       copy text to the system clipboard
#
# Needs DOKPLOY_URL (e.g. https://dokploy.example.com) and DOKPLOY_API_KEY
# (Dokploy: Settings > API/CLI). Each is resolved on its own, first hit wins:
#
#   1. the variable itself, from the environment
#   2. ~/.config/dokploy/env — sourced as a shell file, so it can set either the
#      variables directly or the *_CMD hooks below
#   3. $DOKPLOY_URL_CMD / $DOKPLOY_API_KEY_CMD — any shell command; the first line
#      of its stdout becomes the value (pass, 1password, bitwarden, sops, gopass, …)
#   4. pass show personal/dokploy/url  /  personal/dokploy/api-key
#   5. <script dir>/.env — DOKPLOY_URL=… / DOKPLOY_API_KEY=… lines
#
# Example ~/.config/dokploy/env:
#   DOKPLOY_URL=https://dokploy.example.com
#   DOKPLOY_API_KEY_CMD='pass show personal/dokploy/api-key'

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dokploy-previews"
CONFIG_ERR=""

die() {
  printf 'dokploy-previews: %s\n' "$*" >&2
  exit 1
}

# A row tv can render when there is nothing to list but something to say.
row_message() {
  printf '%s\t\t\t\n' "$1"
}

from_dotenv() {
  [ -f "$SCRIPT_DIR/.env" ] || return 0
  sed -n "s/^$1=//p" "$SCRIPT_DIR/.env" | head -1
}

# resolve <VAR> <pass-entry> — print the value of VAR, or nothing if unresolvable.
# Checked in order: VAR itself, ${VAR}_CMD, pass, the dotenv file next to this script.
resolve() {
  local var="$1" pass_entry="$2" cmd_var="${1}_CMD" cmd val
  val="${!var:-}"
  [ -n "$val" ] && { printf '%s' "$val"; return 0; }

  # Don't pipe into head: that can SIGPIPE gpg mid-decrypt. Take the first line
  # afterwards instead. Keep stderr only under `auth`, where the user is looking
  # at a plain terminal — during `list` it would be painted over tv's UI.
  cmd="${!cmd_var:-}"
  if [ -n "$cmd" ]; then
    if [ -n "${RESOLVE_VERBOSE:-}" ]; then val=$(eval "$cmd"); else val=$(eval "$cmd" 2>/dev/null); fi
    val=${val%%$'\n'*}
    [ -n "$val" ] && { printf '%s' "$val"; return 0; }
  fi

  if [ -n "${RESOLVE_VERBOSE:-}" ]; then val=$(pass show "$pass_entry"); else val=$(pass show "$pass_entry" 2>/dev/null); fi
  val=${val%%$'\n'*}
  [ -n "$val" ] && { printf '%s' "$val"; return 0; }

  val=$(from_dotenv "$var")
  [ -n "$val" ] && { printf '%s' "$val"; return 0; }
  return 1
}

load_config() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/dokploy/env"
  # Remember what the environment already said: sourcing the config file would
  # otherwise clobber it, and the environment is documented to outrank the file.
  local env_url="${DOKPLOY_URL:-}" env_key="${DOKPLOY_API_KEY:-}"
  local env_url_cmd="${DOKPLOY_URL_CMD:-}" env_key_cmd="${DOKPLOY_API_KEY_CMD:-}"

  # shellcheck disable=SC1090
  [ -f "$cfg" ] && . "$cfg"

  [ -n "$env_url" ] && DOKPLOY_URL="$env_url"
  [ -n "$env_key" ] && DOKPLOY_API_KEY="$env_key"
  [ -n "$env_url_cmd" ] && DOKPLOY_URL_CMD="$env_url_cmd"
  [ -n "$env_key_cmd" ] && DOKPLOY_API_KEY_CMD="$env_key_cmd"

  DOKPLOY_URL=$(resolve DOKPLOY_URL personal/dokploy/url)
  if [ -z "$DOKPLOY_URL" ]; then
    CONFIG_ERR="DOKPLOY_URL is not set — see 'dokploy-previews --help'"
    return 1
  fi
  DOKPLOY_API_KEY=$(resolve DOKPLOY_API_KEY personal/dokploy/api-key)
  if [ -z "$DOKPLOY_API_KEY" ]; then
    CONFIG_ERR="DOKPLOY_API_KEY is not set — see 'dokploy-previews --help'"
    return 1
  fi

  DOKPLOY_URL="${DOKPLOY_URL%/}"
  export DOKPLOY_URL DOKPLOY_API_KEY
}

# api <procedure> [query-string] — Dokploy exposes its tRPC queries as GET /api/<procedure>
api() {
  local path="$1" query="${2:-}"
  curl -fsS --max-time 20 \
    -H "x-api-key: $DOKPLOY_API_KEY" \
    -H "accept: application/json" \
    "$DOKPLOY_URL/api/$path${query:+?$query}"
}

# The remote to compare against: the upstream of the current branch, else origin.
remote_slug() {
  local remote="${1:-}" branch url
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "not inside a git repository" >&2
    return 1
  }
  if [ -z "$remote" ]; then
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    [ -n "$branch" ] && remote=$(git config --get "branch.$branch.remote" 2>/dev/null)
    [ -n "$remote" ] || remote=origin
  fi
  url=$(git remote get-url "$remote" 2>/dev/null) || {
    echo "no git remote named '$remote'" >&2
    return 1
  }
  # scp-style, ssh:// and https:// all reduce to the trailing <owner>/<repo>
  printf '%s\n' "$url" |
    sed -E 's#/+$##; s#\.git$##; s#^.*[:/]([^/:]+)/([^/]+)$#\1/\2#'
}

cache_file() {
  printf '%s/%s.json\n' "$CACHE_DIR" "$(printf '%s' "$1" | tr '/' '_')"
}

# ------------------------------------------------------------------ subcommands

# internal: fetch one application's preview deployments into <dir>/<id>.json
cmd_fetch_previews() {
  local dir="$1" app_id="$2"
  api previewDeployment.all "applicationId=$app_id" >"$dir/$app_id.json" 2>/dev/null || printf '[]' >"$dir/$app_id.json"
}

cmd_list() {
  local slug owner repo projects apps ids cache
  # stderr is folded into the result so failures show up as a row inside tv
  slug=$(remote_slug "${1:-}" 2>&1) || {
    row_message "✖ $slug"
    exit 0
  }
  owner="${slug%%/*}"
  repo="${slug##*/}"

  load_config || {
    row_message "✖ $CONFIG_ERR"
    exit 0
  }

  projects=$(api project.all 2>/dev/null) || {
    row_message "✖ cannot reach $DOKPLOY_URL — check DOKPLOY_URL / DOKPLOY_API_KEY"
    exit 0
  }

  # applicationId -> "<project>/<application>", used only for the display column
  apps=$(printf '%s' "$projects" | jq -c '
    [ .[]? as $p
      | ($p.environments // [])[]
      | ($p.name) as $pn
      | (.applications // [])[]
      | { key: .applicationId, value: ($pn + "/" + .name) }
    ] | from_entries')

  ids=$(printf '%s' "$apps" | jq -r 'keys[]?')
  if [ -z "$ids" ]; then
    row_message "✖ no applications visible with this API key"
    exit 0
  fi

  # global, not local: the EXIT trap fires after this function's scope is gone
  TMPD=$(mktemp -d) || die "mktemp failed"
  trap 'rm -rf "${TMPD:-}"' EXIT
  printf '%s\n' "$ids" | xargs -r -P 8 -I {} "$SELF" _fetch-previews "$TMPD" {}

  # Keep the deployments whose pull request lives in this repo. Every forge puts
  # /<owner>/<repo>/ in the PR url (github /pull/N, gitlab /-/merge_requests/N,
  # gitea /pulls/N, bitbucket /pull-requests/N), so one substring test covers all.
  local merged
  merged=$(cat "$TMPD"/*.json 2>/dev/null | jq -s -c \
    --argjson apps "$apps" --arg owner "$owner" --arg repo "$repo" '
    ("/" + ($owner | ascii_downcase) + "/" + ($repo | ascii_downcase) + "/") as $needle
    | [ add[]?
        | select(((.pullRequestURL // "") | ascii_downcase) | contains($needle))
        | . + { appLabel: ($apps[.applicationId] // "?") }
      ]
    | sort_by(.createdAt) | reverse')
  [ -n "$merged" ] || merged="[]"

  mkdir -p "$CACHE_DIR"
  cache=$(cache_file "$slug")
  printf '%s' "$merged" >"$cache"

  if [ "$(printf '%s' "$merged" | jq 'length')" = "0" ]; then
    row_message "○ no preview deployments for $owner/$repo"
    exit 0
  fi

  printf '%s' "$merged" | jq -r '
    def pad($s; $n): $s + (($n - ($s | length)) as $d | if $d > 0 then " " * $d else "" end);
    def glyph: { done: "✔", running: "◐", error: "✖", idle: "○" }[.] // "•";
    .[]
    | (.previewStatus // "idle") as $st
    | ("#" + (.pullRequestNumber // "?")) as $pr
    | (.domain
       | if . == null or (.host // "") == "" then ""
         else (if .https then "https" else "http" end) + "://" + .host
              + ((.path // "/") | if . == "/" or . == "" then "" else . end)
         end) as $url
    | [ ($st | glyph) + " " + pad($pr; 5) + " " + pad($st; 8) + " "
        + (.pullRequestTitle // "(no title)")
        + "  ·  " + (.branch // "?")
        + "  ·  " + .appLabel,
        $url,
        (.pullRequestURL // ""),
        .previewDeploymentId,
        (.branch // ""),
        (.pullRequestNumber // "")
      ] | @tsv'
}

cmd_preview() {
  local id="$1" slug cache
  [ -n "$id" ] || { echo "no selection"; return 0; }
  slug=$(remote_slug 2>/dev/null) || { echo "not inside a git repository"; return 0; }
  cache=$(cache_file "$slug")
  [ -f "$cache" ] || { echo "no cached data — press ctrl-r to reload"; return 0; }

  jq -r --arg id "$id" '
    def c($n; $s): "[" + $n + "m" + $s + "[0m";
    def lbl($s): c("36"; $s);
    def statuscolor: { done: "32", running: "33", error: "31", idle: "90" }[.] // "37";
    def ago($iso):
      (($iso // "") | if . == "" then "unknown"
       else (try (sub("\\.[0-9]+"; "") | sub("Z$"; "Z") | fromdateiso8601) catch null) as $t
            | if $t == null then $iso
              else (now - $t) as $d
                   | ($d | fabs) as $a
                   | (if $a < 3600 then (($a/60)|floor|tostring) + "m"
                      elif $a < 86400 then (($a/3600)|floor|tostring) + "h"
                      else (($a/86400)|floor|tostring) + "d" end) as $span
                   | if $d < 0 then "in " + $span else $span + " ago" end
              end
       end);

    (map(select(.previewDeploymentId == $id)) | first) as $p
    | if $p == null then "entry is stale — press ctrl-r to reload" else
      ($p.previewStatus // "idle") as $st
    | ($p.domain
       | if . == null or (.host // "") == "" then ""
         else (if .https then "https" else "http" end) + "://" + .host
              + ((.path // "/") | if . == "/" or . == "" then "" else . end)
         end) as $url
    | [ "  " + c("1"; ($p.pullRequestTitle // "(no title)")),
        "  " + c("90"; "#" + ($p.pullRequestNumber // "?") + "  ·  " + $p.appLabel),
        "",
        "  " + lbl("Status:  ") + c($st | statuscolor; $st),
        "  " + lbl("Branch:  ") + ($p.branch // "?"),
        "  " + lbl("Preview: ") + (if $url == "" then c("90"; "no domain assigned") else c("34"; $url) end),
        "  " + lbl("PR:      ") + c("34"; $p.pullRequestURL // "-"),
        "  " + lbl("Created: ") + ago($p.createdAt),
        (if ($p.expiresAt // "") != "" then "  " + lbl("Expires: ") + ago($p.expiresAt) else empty end),
        "  " + lbl("App:     ") + c("90"; $p.appName // "-"),
        "",
        "  " + c("90"; "──────────────────────────────────────────────"),
        "",
        "  " + lbl("Deployments"),
        (($p.deployments // []) | if length == 0 then ["  " + c("90"; "  none yet")]
          else .[0:10] | to_entries | map(
            "    " + c(({ done: "32", running: "33", error: "31", idle: "90" }[.value.status] // "37");
                       ({ done: "✔", running: "◐", error: "✖", idle: "○" }[.value.status] // "•"))
            + " " + ((.value.title // "deployment") | .[0:52])
            + "  " + c("90"; ago(.value.createdAt)))
          end)
      ] | flatten | join("\n")
      end' "$cache"
}

# Resolve the credentials and throw them away. The point is the side effect:
# if the secret lives behind gpg/pass/1password, its prompt happens HERE, in a
# plain terminal, instead of inside tv — a full-screen TUI owns stdin, so a
# pinentry spawned underneath it can draw but never receives a keystroke.
cmd_auth() {
  RESOLVE_VERBOSE=1
  load_config || die "$CONFIG_ERR"
  api project.all >/dev/null 2>&1 || die "cannot reach $DOKPLOY_URL — check the url and key"
}

cmd_open() {
  local url="$1"
  [ -n "$url" ] || die "nothing to open"
  if [ -n "${BROWSER:-}" ]; then "$BROWSER" "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then wslview "$url" >/dev/null 2>&1 &
  elif command -v sensible-browser >/dev/null 2>&1; then sensible-browser "$url" >/dev/null 2>&1 &
  else die "no browser opener found"
  fi
  disown 2>/dev/null
}

cmd_copy() {
  local text="$1"
  [ -n "$text" ] || die "nothing to copy"
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$text" | wl-copy
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$text" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard
  elif command -v clip.exe >/dev/null 2>&1; then
    printf '%s' "$text" | clip.exe
  else
    die "no clipboard tool found (wl-copy, xclip or clip.exe)"
  fi
  command -v notify-send >/dev/null 2>&1 && notify-send -t 2000 "Copied" "$text" >/dev/null 2>&1
  return 0
}

case "${1:-list}" in
list) cmd_list "${2:-}" ;;
preview) cmd_preview "${2:-}" ;;
auth) cmd_auth ;;
open) cmd_open "${2:-}" ;;
copy) cmd_copy "${2:-}" ;;
_fetch-previews)
  load_config || die "$CONFIG_ERR"
  cmd_fetch_previews "$2" "$3"
  ;;
-h | --help | help) sed -n '2,29p' "$SELF" | sed 's/^#\( \|$\)//' ;;
*) die "unknown subcommand: $1 (try --help)" ;;
esac
