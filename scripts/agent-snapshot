#!/usr/bin/env bash
# agent-snapshot — record exactly which agent sessions are live, so a cold start
# can resume the CONVERSATIONS, not just reopen shells in the right folders.
#
#   agent-snapshot            write a snapshot now
#   agent-snapshot --auto     same, but never replace a snapshot from before the
#                             last boot that has not been restored yet (timer)
#   agent-snapshot --show     print the newest snapshot
#   agent-snapshot --restore  emit the commands to bring it all back (dry run)
#   agent-snapshot --restore --yes   actually recreate the tmux windows
#
# Why this rather than `workmux resurrect`: workmux records the WORKTREE that
# had an agent, which is enough to reopen a window but not to get the
# conversation back. Here the session id comes from the file each agent keeps
# for itself (omp: a breadcrumb per terminal; claude: one file per pid), so it
# is exact rather than a guess at "newest file in that directory", which goes
# wrong whenever two sessions ran in one worktree.

set -uo pipefail

DIR="${AGENT_SNAPSHOT_DIR:-$HOME/.local/state/agent-snapshots}"
mkdir -p "$DIR"
CUR="$DIR/latest.tsv"

collect() {
  # tmux pane_pid -> pane location, so a snapshot row knows where it lived.
  declare -A LOC
  while read -r ppid sess win pane; do
    LOC["$ppid"]="$sess|$win|$pane"
  done < <(tmux list-panes -a -F '#{pane_pid} #{session_name} #{window_index} #{pane_index}' 2>/dev/null)

  for pid in $(pgrep -x omp; pgrep -x claude; pgrep -x pi); do
    local comm cwd sf sid loc anc tty bc
    comm=$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ')
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null)
    [[ -z "$cwd" ]] && continue

    # Where each agent itself records which session a process is running.
    # These are rewritten whenever the session changes, so they are exact
    # without having to catch the agent mid-write.
    sid=""
    case "$comm" in
      omp)
        # One breadcrumb per terminal: line 2 is the session file. Keyed by
        # the pty, and only read for a LIVE omp on that pty, so a leftover
        # breadcrumb from an earlier omp in the same terminal is never used.
        tty=$(readlink "/proc/$pid/fd/0" 2>/dev/null)
        bc="$HOME/.omp/agent/terminal-sessions/${tty#/dev/}"; bc=${bc/pts\//pts-}
        [[ -f "$bc" ]] && sf=$(sed -n 2p "$bc") && \
          sid=$(basename "$sf" .jsonl | sed 's/^[0-9T:.Z-]*_//')
        ;;
      claude)
        sf="$HOME/.claude/sessions/$pid.json"
        [[ -f "$sf" ]] && sid=$(jq -r '.sessionId // empty' "$sf" 2>/dev/null)
        ;;
    esac

    # Fallback (pi, or an agent too old to write the above): the session
    # .jsonl, if it happens to be open right now. Match the BASENAME against
    # an id: subagent logs like Task9ChatNotify.jsonl sit inside a directory
    # whose name carries the id, so a path-wide match would let them through.
    if [[ -z "$sid" ]]; then
      sf=$(ls -l "/proc/$pid/fd" 2>/dev/null \
           | grep -oE '/[^ ]*/(sessions|projects)/[^ ]*\.jsonl' \
           | while read -r f; do
               b=$(basename "$f")
               [[ "$b" =~ [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jsonl$ ]] && echo "$f"
             done | head -1)
      [[ -n "$sf" ]] && sid=$(basename "$sf" .jsonl | sed 's/^[0-9T:.Z-]*_//')
    fi
    [[ -z "$sid" ]] && continue

    # Walk up to the tmux pane that owns this agent.
    loc=""; anc=$pid
    for _ in $(seq 1 12); do
      [[ -n "${LOC[$anc]:-}" ]] && { loc="${LOC[$anc]}"; break; }
      anc=$(ps -o ppid= -p "$anc" 2>/dev/null | tr -d ' ')
      [[ -z "$anc" || "$anc" == "1" ]] && break
    done

    printf '%s\t%s\t%s\t%s\n' "$comm" "$cwd" "$sid" "${loc:-?|?|?}"
  done
}

case "${1:-}" in
  --show)
    [[ -f "$CUR" ]] || { echo "no snapshot yet"; exit 0; }
    echo "snapshot from $(date -r "$CUR" '+%Y-%m-%d %H:%M:%S')"
    awk -F'\t' '{split($4,l,"|"); printf "  %-7s %-52s %s  [%s]\n",$1,$2,substr($3,1,13),l[1]}' "$CUR"
    ;;
  --restore)
    [[ -f "$CUR" ]] || { echo "no snapshot to restore"; exit 1; }
    yes=0; [[ "${2:-}" == "--yes" ]] && yes=1
    echo "# from snapshot $(date -r "$CUR" '+%Y-%m-%d %H:%M:%S')"
    # Windows are named after the agent. Two of the same agent in one session
    # get numbered (omp1, omp2); a lone one stays plain (omp). Count first so
    # the first of a pair is already omp1 rather than a bare omp.
    declare -A TOTAL SEEN
    while IFS=$'\t' read -r comm cwd _ loc; do
      [[ -d "$cwd" ]] || continue   # skipped below, so must not count
      k="${loc%%|*}|$comm"; TOTAL["$k"]=$(( ${TOTAL["$k"]:-0} + 1 ))
    done < "$CUR"
    while IFS=$'\t' read -r comm cwd sid loc; do
      [[ -d "$cwd" ]] || { echo "# SKIP (gone): $cwd"; continue; }
      sess="${loc%%|*}"
      case "$comm" in
        # tmux runs this via `nu -c`, which skips config.nu, so the `omp` ->
        # omp-capped wrapper does not exist there. Name the capped one directly
        # or restored agents come back without their memory limit.
        omp)    cmd="omp-capped --resume $sid" ;;
        pi)     cmd="pi --resume $sid" ;;
        claude) cmd="claude --resume $sid" ;;
        *) continue ;;
      esac
      k="$sess|$comm"; SEEN["$k"]=$(( ${SEEN["$k"]:-0} + 1 ))
      win=$comm; (( TOTAL["$k"] > 1 )) && win="$comm${SEEN["$k"]}"
      if (( yes )); then
        # After a cold start the recorded tmux session does not exist yet, and
        # `new-window -t <missing>` fails with "can't find window". Create the
        # session first (which also opens its first window), otherwise fall
        # back to adding a window to it.
        if [[ -n "$sess" && "$sess" != "?" ]]; then
          if tmux has-session -t "$sess" 2>/dev/null; then
            tmux new-window -d -t "$sess" -c "$cwd" -n "$win" "$cmd" 2>/dev/null
          else
            tmux new-session -d -s "$sess" -c "$cwd" -n "$win" "$cmd" 2>/dev/null
          fi
        else
          tmux new-window -d -c "$cwd" -n "$win" "$cmd" 2>/dev/null
        fi
        (( $? == 0 )) && echo "restored: $sess -> $cwd ($comm)" \
                      || echo "FAILED:   $sess -> $cwd ($comm)"
      else
        if [[ -n "$sess" && "$sess" != "?" ]]; then
          echo "tmux has-session -t '$sess' 2>/dev/null && tmux new-window -d -t '$sess' -c '$cwd' -n '$win' '$cmd' || tmux new-session -d -s '$sess' -c '$cwd' -n '$win' '$cmd'"
        else
          echo "tmux new-window -d -c '$cwd' -n '$win' '$cmd'"
        fi
      fi
    done < "$CUR"
    # Marks the pre-reboot snapshot as dealt with, so --auto may replace it.
    (( yes )) && touch "$DIR/restored" || echo "# add --yes to run these"
    ;;
  *)
    # After a restart the timer would otherwise replace the snapshot you are
    # about to restore with whatever few agents happen to be up already.
    # Until that pre-boot snapshot is restored, --auto keeps latest.tsv and
    # only adds to the history.
    keep=0
    if [[ "${1:-}" == "--auto" && -f "$CUR" ]]; then
      boot=$(date -d "$(uptime -s)" +%s)
      if (( $(date -r "$CUR" +%s) < boot )) && \
         ! [[ "$DIR/restored" -nt "$CUR" ]]; then
        keep=1
      fi
    fi
    n=$(collect | tee "$CUR.tmp" | wc -l)
    if (( n > 0 )); then
      cp "$CUR.tmp" "$DIR/$(date +%Y%m%d-%H%M%S).tsv"
      if (( keep )); then
        rm -f "$CUR.tmp"
        echo "kept the pre-reboot snapshot; restore it to resume auto-saving"
      else
        mv "$CUR.tmp" "$CUR"
      fi
      # With a save every 5 minutes, prune by age rather than count.
      find "$DIR" -maxdepth 1 -name '2*.tsv' -mtime +14 -delete
    else
      rm -f "$CUR.tmp"   # never overwrite a good snapshot with an empty one
    fi
    echo "$n agent session(s) recorded"
    ;;
esac
